          "email": {
            "title": "Email",
            "type": "string"
          },
          "attributes": {
            "additionalProperties": true,
            "description": "Contact attributes, e.g. {'FIRSTNAME':'Ada'}.",
            "title": "Attributes",
            "type": "object"
          },
          "list_ids": {
            "description": "Optional existing Brevo list IDs.",
            "items": {
              "type": "integer"
            },
            "title": "List Ids",
            "type": "array"
          }
        },
        "required": [
          "email"
        ],
        "title": "CreateContactParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_brevo-connector_chat"
    },
