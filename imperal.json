{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "brevo-connector",
  "version": "0.1.0",
  "name": "Brevo",
  "description": "Connect Brevo with an API key to manage contacts, lists, campaigns, and transactional email.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "brevo:read",
    "brevo:write"
  ],
  "tools": [
    {
      "name": "connect_brevo",
      "description": "Connect Brevo using an API key after verifying it against the account endpoint.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "Friendly label, e.g. Marketing workspace.",
            "title": "Label",
            "type": "string"
          },
          "api_key": {
            "description": "Brevo API key from SMTP & API > API Keys.",
            "title": "Api Key",
            "type": "string"
          }
        },
        "required": [
          "api_key"
        ],
        "title": "ConnectBrevoParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_brevo-connector_chat"
    },
    {
      "name": "disconnect_brevo",
      "description": "Disconnect a Brevo account and delete only its locally saved API key.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "delete:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "title": "Connection Id",
            "type": "string"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "DisconnectParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_brevo-connector_chat"
    },
    {
      "name": "list_connections",
      "description": "List saved Brevo accounts without exposing their API keys.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "Connection": {
            "properties": {
              "id": {
                "default": "",
                "title": "Id",
                "type": "string"
              },
              "label": {
                "default": "",
                "title": "Label",
                "type": "string"
              },
              "email": {
                "default": "",
                "title": "Email",
                "type": "string"
              }
            },
            "title": "Connection",
            "type": "object"
          }
        },
        "properties": {
          "connections": {
            "items": {
              "$ref": "#/$defs/Connection"
            },
            "title": "Connections",
            "type": "array"
          }
        },
        "title": "ConnectionList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_brevo-connector_chat"
    },
    {
      "name": "list_contacts",
