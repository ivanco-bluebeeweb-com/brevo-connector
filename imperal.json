            "title": "Connection Id",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "ListContactsParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "Contact": {
            "properties": {
              "email": {
                "default": "",
