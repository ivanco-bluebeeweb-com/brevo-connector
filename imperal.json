              },
              "id": {
                "default": 0,
                "title": "Id",
                "type": "integer"
              },
              "attributes": {
                "additionalProperties": true,
                "title": "Attributes",
                "type": "object"
              }
            },
            "title": "Contact",
            "type": "object"
          }
        },
        "properties": {
          "contacts": {
            "items": {
              "$ref": "#/$defs/Contact"
            },
            "title": "Contacts",
            "type": "array"
          }
