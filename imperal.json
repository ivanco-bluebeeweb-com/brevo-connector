        "title": "ContactList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_brevo-connector_chat"
    },
    {
      "name": "create_contact",
      "description": "Create or update a Brevo contact, optionally adding it to existing lists.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:contact"
